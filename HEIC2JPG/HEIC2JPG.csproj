<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot/sw.js" PublishedContent="wwwroot/sw.published.js" />
    <Content Remove="wwwroot\sw.js;wwwroot\sw.published.js" />
  </ItemGroup>

  <!-- リソースファイルサポート（Blazor WebAssembly用） -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LogicalName>HEIC2JPG.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.en.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LogicalName>HEIC2JPG.Resources.Strings.en.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.zh-Hans.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LogicalName>HEIC2JPG.Resources.Strings.zh-Hans.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="GenerateLicenses" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)\GenerateLicenses.ps1;$(MSBuildProjectDirectory)\wwwroot\vendor-manifest.json"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\licenses.json">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateLicenses.ps1&quot;" />
  </Target>

</Project>
